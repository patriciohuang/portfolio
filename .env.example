# Copy this file to .env.local and fill in your EmailJS values.
# Dashboard: https://dashboard.emailjs.com

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Notification template sent to you. Use EmailJS's "Auto-Reply" link on this
# template to also send a confirmation to the visitor.
VITE_EMAILJS_TEMPLATE_ID=your_notification_template_id
